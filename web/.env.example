# Which chain the app talks to: "bsc" (BNB Smart Chain mainnet, chain 56) or "localhost" (Hardhat node, chain 31337).
VITE_CHAIN=bsc
# Address of the deployed SqrJobs escrow contract. The token and Agent ID registry are read from it.
VITE_SQRJOBS_ADDRESS=
# Public JSON-RPC used for reads on bsc. Writes always go through the user's wallet.
VITE_BSC_RPC_URL=https://bsc-rpc.publicnode.com
# RPC for VITE_CHAIN=localhost.
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
# Link target for the agent skill docs.
VITE_REPO_URL=https://github.com/sqrDAO/sqrJOBS
